{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rsasaki0109/oss_license_checker/schemas/distribution-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "distribution",
    "components",
    "evidence",
    "requirements"
  ],
  "properties": {
    "format": {
      "const": "distribution-review-draft"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "kind",
        "scope_confirmed",
        "artifact_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "undecided",
            "source",
            "wheel",
            "container",
            "binary",
            "other"
          ]
        },
        "scope_confirmed": {
          "type": "boolean"
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inclusion",
          "inclusion_basis",
          "review_state",
          "license_expression",
          "evidence_refs",
          "name",
          "revision",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inclusion": {
            "enum": [
              "bundled",
              "external",
              "unknown"
            ]
          },
          "inclusion_basis": {
            "type": "string",
            "minLength": 1
          },
          "review_state": {
            "enum": [
              "needs_review",
              "reviewed",
              "blocked"
            ]
          },
          "license_expression": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "python_distribution",
              "source_code",
              "data",
              "other"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "location",
          "sha256",
          "artifact_sha256",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "collected_license",
              "source_reference",
              "artifact_inspection",
              "fulfillment_record"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component_ref",
          "kind",
          "description",
          "basis",
          "state",
          "reason",
          "evidence_refs",
          "reviewed_by",
          "reviewed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component_ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "scope_review",
              "license_review",
              "license_copy",
              "copyright_notice",
              "notice",
              "source_availability",
              "relinking",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "needs_review",
              "todo",
              "done",
              "not_applicable",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reviewed_by": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "done",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reviewed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
